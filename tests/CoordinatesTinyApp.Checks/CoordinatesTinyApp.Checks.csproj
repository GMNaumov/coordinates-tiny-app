<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <!-- Проверяем модели и сервисы без зависимости от WPF. -->
    <Compile Include="../../src/CoordinatesTinyApp/Models/*.cs" Link="Models/%(Filename)%(Extension)" />
    <Compile Include="../../src/CoordinatesTinyApp/Services/*.cs" Link="Services/%(Filename)%(Extension)" />
    <PackageReference Include="Npgsql" Version="8.0.9" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>
</Project>
