<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <!-- Проверяем исходную предметную логику без зависимости от WPF и сторонних пакетов. -->
    <Compile Include="../../src/CoordinatesTinyApp/Models/*.cs" Link="Models/%(Filename)%(Extension)" />
    <Compile Include="../../src/CoordinatesTinyApp/Services/*.cs" Link="Services/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
