<Window x:Class="CoordinatesTinyApp.Views.DatabaseRecordPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Выбор матрицы из PostgreSQL" Width="1120" Height="650" MinWidth="920" MinHeight="500"
        WindowStartupLocation="CenterOwner" Loaded="Window_Loaded" Closed="Window_Closed">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,12">
            <Button x:Name="SettingsButton" DockPanel.Dock="Right" Content="Настройки подключения…" Command="{Binding SettingsCommand}" />
            <StackPanel>
                <TextBlock Text="Координаты из PostgreSQL" FontSize="22" FontWeight="SemiBold" />
                <TextBlock Text="{Binding ConnectionText}" Margin="0,4,0,0" Foreground="#4B5563" TextWrapping="Wrap" />
            </StackPanel>
        </DockPanel>
        <DockPanel IsEnabled="{Binding IsIdle}" Grid.Row="1" Margin="0,0,0,12">
            <Button DockPanel.Dock="Right" Content="Найти / обновить" Margin="8,0,0,0" Command="{Binding SearchCommand}" />
            <Label DockPanel.Dock="Left" Content="ID объекта или GUID:" Target="{Binding ElementName=SearchTextBox}" VerticalAlignment="Center" />
            <TextBox x:Name="SearchTextBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="6" VerticalContentAlignment="Center" MaxLength="64"
                     ToolTip="Пустое поле — все записи. Для применения поиска нажмите «Найти / обновить»." />
        </DockPanel>
        <DataGrid x:Name="RecordsDataGrid" ItemsSource="{Binding Records}" SelectedItem="{Binding SelectedRecord}" IsEnabled="{Binding IsIdle}" Grid.Row="2" IsReadOnly="True" AutoGenerateColumns="False"
                  CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False"
                  SelectionMode="Single" SelectionUnit="FullRow" HeadersVisibility="Column"
                  HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                  MouseDoubleClick="RecordsDataGrid_MouseDoubleClick"
                  AutomationProperties.Name="Записи координат">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID объекта справочника" Binding="{Binding ObjectId}" Width="190" />
                <DataGridTextColumn Header="GUID объекта" Binding="{Binding ObjectGuid}" Width="290" />
                <DataGridTextColumn Header="Матрица трансформации" Binding="{Binding PlacementDisplay}" Width="*" MinWidth="300" />
            </DataGrid.Columns>
        </DataGrid>
        <TextBlock Text="{Binding StatusMessage}" Grid.Row="3" Margin="0,12" TextWrapping="Wrap" Foreground="{Binding StatusColor}"
                   AutomationProperties.LiveSetting="Polite" />
        <DockPanel Grid.Row="4">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="SelectButton" Content="Загрузить матрицу"
                        Style="{StaticResource PrimaryButtonStyle}" Command="{Binding SelectCommand}" />
                <Button Content="Отмена" IsCancel="True" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <Button x:Name="PreviousButton" Content="Назад" Command="{Binding PreviousCommand}" />
                <TextBlock Text="{Binding PageText}" VerticalAlignment="Center" Margin="4,0,12,0" />
                <Button x:Name="NextButton" Content="Далее" Command="{Binding NextCommand}" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
