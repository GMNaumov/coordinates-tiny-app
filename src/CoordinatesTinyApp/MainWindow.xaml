<Window x:Class="CoordinatesTinyApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:CoordinatesTinyApp.Views"
        Title="Координаты объектов — TransformationMap"
        Icon="Assets/coordinates.ico"
        Width="1040"
        Height="790"
        MinWidth="900"
        MinHeight="700"
        WindowStartupLocation="CenterScreen">

    <DockPanel Margin="12">
        <Button DockPanel.Dock="Top" Content="Настройки подключения к БД…" HorizontalAlignment="Right"
                Margin="0,0,0,8" Command="{Binding DatabaseSettingsCommand}" />
        <TabControl>
            <TabItem Header="Редактор матрицы">
                <views:MatrixEditorView DataContext="{Binding Editor}" />
            </TabItem>
            <TabItem Header="Сравнение матриц">
                <views:MatrixComparisonView DataContext="{Binding Comparison}" />
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
